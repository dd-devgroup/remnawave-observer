# ============================================
# SERVER
# ============================================
PORT=9000

# ============================================
# POSTGRESQL (required)
# ============================================
POSTGRES_USER=observer
POSTGRES_PASSWORD=observer_password
POSTGRES_DB=observer
POSTGRES_DSN=postgres://observer:observer_password@postgres:5432/observer?sslmode=disable

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# REMNAWAVE API (required)
# ============================================
REMNAWAVE_BASE_URL=https://your-panel.example.com
REMNAWAVE_API_TOKEN=your_api_token_here

# Optional reverse-proxy gate header in KEY=VALUE format
REMNAWAVE_HEADER=

# ============================================
# PANEL INGEST
# ============================================
LOG_SOURCE_MODE=panel
PANEL_POLL_INTERVAL_SECONDS=60
PANEL_FETCH_TIMEOUT_SECONDS=20
PANEL_FETCH_RESULT_POLL_SECONDS=2
PANEL_FETCH_MAX_INFLIGHT=3
NODE_EXECUTOR_BLOCK_ENABLED=true

# ============================================
# CORE BEHAVIOR
# ============================================
BLOCK_DURATION=10m
USER_ASN_TTL_SECONDS=43200
GEOIP_ENABLED=true
SCORE_THRESHOLD_WARN=50.0
SCORE_THRESHOLD_BLOCK=85.0

# ============================================
# EXCLUSIONS / ALERTS
# ============================================
EXCLUDED_USERS=
EXCLUDED_IPS=
EXCLUDED_INTERNAL_SQUAD_UUIDS=
EXCLUDED_ASNS=
ALERT_WEBHOOK_URL=https://<BOT_IP>:<PORT>/webhook/alert
ALERT_COOLDOWN_SECONDS=300

# ============================================
# OPTIONAL GEO FALLBACK
# ============================================
GEO_FALLBACK_ENABLED=false
TWOIP_TOKEN=
GEOLITE_ASN_PATH=/app/data/GeoLite2-ASN.mmdb
GEOLITE_CITY_PATH=/app/data/GeoLite2-City.mmdb
GEODATA_CONFIG_DIR=/app/config
GEODATA_DATA_DIR=/app/data

# ============================================
# OPTIONAL LEARNING / LOGGING
# ============================================
UNKNOWN_PROVIDERS_LOG_ENABLED=false
AUTO_LEARNING_ENABLED=false

# Advanced overrides are intentionally omitted.
# Add them only if you really need non-default behavior from internal/config/config.go.
