# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# Redis SCAN settings
SCAN_COUNT=100                # COUNT hint for SCAN commands
SCAN_TIME_BUDGET_SECONDS=30   # Max time for one SCAN operation

# ============================================
# REMNAWAVE API
# ============================================

# Remnawave panel URL
REMNAWAVE_BASE_URL=https://your-panel.example.com

# API token for panel access
REMNAWAVE_API_TOKEN=your_api_token_here

# User block duration (format: 5m, 10m, 1h)
BLOCK_DURATION=10m

# Re-enable check interval (seconds)
REENABLE_TICK_SECONDS=10

# ============================================
# DETECTION MODES (choose ONE)
# ============================================

# 1. ASN MODE (by providers) - RECOMMENDED for anti-sharing
# Detects provider/operator by IP and groups all IPs of one provider
DETECT_BY_ASN=true
MAX_ASNS_PER_USER=4

# ASN parameters (iptoasn.com - automatically downloaded on startup)
# Leave empty for default URL
IPTOASN_DOWNLOAD_URL=
IPTOASN_UPDATE_INTERVAL_MINUTES=60

ASN_FALLBACK_MASK=16
# Excluded ASNs (CDN, major services)
EXCLUDED_ASNS=AS13335,AS15169,AS16509

# 2. SUBNET DETECTION MODE (alternative)
# DETECT_BY_SUBNET=true
# DETECT_BY_ASN=false
# MAX_SUBNETS_PER_USER=6
# SUBNET_MASK_IPV4=24
# EXCLUDED_SUBNETS=192.168.2.0/24,10.2.2.0/24

# 3. IP DETECTION MODE (simple, not recommended)
# DETECT_BY_ASN=false
# DETECT_BY_SUBNET=false
# MAX_IPS_PER_USER=12
# EXCLUDED_IPS=1.1.1.1,8.8.8.8

# ============================================
# REDIS TTL
# ============================================

# TTL for Redis entries (seconds, 1 hour = 3600)
USER_SUBNET_TTL_SECONDS=3600
USER_IP_TTL_SECONDS=3600

# ============================================
# HTTP SERVER
# ============================================

# Max POST /log-entry body size in bytes (default: 2097152 = 2MB)
MAX_REQUEST_BYTES=2097152

# Max entries per request (default: 1000)
MAX_LOG_ENTRIES_PER_REQUEST=1000

# ============================================
# WEBHOOK ALERTS
# ============================================

# Webhook URL for your TG bot
ALERT_WEBHOOK_URL=https://<BOT_IP>:<PORT>/webhook/alert

# Alert cooldown per user (seconds)
ALERT_COOLDOWN_SECONDS=300

# ============================================
# EXCLUSIONS
# ============================================

# Excluded users (comma-separated IDs)
EXCLUDED_USERS=

# ============================================
# GEOIP ANALYSIS
# ============================================

# Enable GeoIP analysis
GEOIP_ENABLED=true

# GeoIP cache TTL in hours (default: 24)
GEOIP_CACHE_TTL_HOURS=24

# Config directory (agglomerations.yaml, providers.yaml)
# In Docker usually /app/config (read-only)
GEODATA_CONFIG_DIR=/app/config

# Writable data directory (unknown_providers.json, backups)
# In Docker usually /app/data (read-write)
GEODATA_DATA_DIR=/app/data

# ============================================
# SCORING
# ============================================

# Enable scoring system
SCORING_ENABLED=true

# Warning threshold (default: 50.0)
SCORE_THRESHOLD_WARN=50.0

# Block threshold (default: 85.0)
SCORE_THRESHOLD_BLOCK=85.0

# Enable unknown providers logging (default: false)
UNKNOWN_PROVIDERS_LOG_ENABLED=true

# ============================================
# AUTO-LEARNING
# ============================================

# Enable auto-learning (default: false)
AUTO_LEARNING_ENABLED=true

# Check interval in hours (default: 24)
AUTO_LEARNING_INTERVAL_HOURS=24

# Min occurrences for auto-add (default: 10)
AUTO_LEARNING_MIN_COUNT=10

# Min confidence level: high, medium, low (default: high)
AUTO_LEARNING_MIN_CONFIDENCE=high

# Max new keywords per cycle (default: 20)
AUTO_LEARNING_MAX_ADDS_PER_RUN=20

# Overlay file name in dataDir (default: providers.learned.yaml)
AUTO_LEARNING_OUTPUT_FILE=providers.learned.yaml

# ============================================
# CAIDA AS-Organizations
# ============================================

# Enable CAIDA AS-Organizations loading (default: true)
CAIDA_ENABLED=true

# CAIDA file URL (leave empty for default)
CAIDA_DOWNLOAD_URL=

# CAIDA refresh interval in hours (default: 168 = 7 days)
CAIDA_REFRESH_HOURS=168

# ============================================
# DEBUG
# ============================================

# Debug mode (optional)
#DEBUG_EMAIL=debug_user
#DEBUG_IP_LIMIT=1
