# ============================================
# SERVER
# ============================================
PORT=9000

# ============================================
# POSTGRESQL (required)
# ============================================

# PostgreSQL credentials (used by docker-compose/services)
POSTGRES_USER=observer
POSTGRES_PASSWORD=observer_password
POSTGRES_DB=observer

# PostgreSQL connection string used by observer service
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
POSTGRES_DSN=postgres://observer:observer_password@postgres:5432/observer?sslmode=disable

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# Redis SCAN settings
SCAN_MAX_KEYS=10000
SCAN_COUNT=100
SCAN_TIME_BUDGET_SECONDS=30

# ============================================
# LOG PROCESSING QUEUES
# ============================================

# Queue/pool sizing and intervals are auto-managed by the service.

# Delay before ASN data cleanup after enforcement (seconds)
CLEAR_IPS_DELAY_SECONDS=30

# ============================================
# REMNAWAVE API / ENFORCEMENT
# ============================================
REMNAWAVE_BASE_URL=https://your-panel.example.com
# Use raw token/JWT value without "Bearer " prefix.
REMNAWAVE_API_TOKEN=your_api_token_here

# HTTP timeout for Remnawave API requests (seconds)
REMNAWAVE_TIMEOUT_SECONDS=5

# Optional reverse-proxy gate bypass (single value: KEY=VALUE).
# Example: REMNAWAVE_HEADER=gate_key=gate_value
REMNAWAVE_HEADER=

# Cache TTL for internal_id -> uuid mapping (hours)
USERID_UUID_CACHE_TTL_HOURS=24

# Block duration format (examples: 5m, 10m, 1h)
BLOCK_DURATION=10m

# ============================================
# ASN DETECTION
# ============================================
MAX_ASNS_PER_USER=4
USER_ASN_TTL_SECONDS=86400

# iptoasn.com updater settings
IPTOASN_DOWNLOAD_URL=
IPTOASN_UPDATE_INTERVAL_MINUTES=60

# Excluded ASNs (comma-separated)
EXCLUDED_ASNS=AS13335,AS15169,AS16509

# ============================================
# WEBHOOK ALERTS
# ============================================
ALERT_WEBHOOK_URL=https://<BOT_IP>:<PORT>/webhook/alert
ALERT_COOLDOWN_SECONDS=300

# ============================================
# EXCLUSIONS
# ============================================
EXCLUDED_USERS=
EXCLUDED_IPS=

# ============================================
# GEOIP ANALYSIS
# ============================================
GEOIP_ENABLED=true
GEOIP_CACHE_TTL_HOURS=24

# External Geo fallback provider (2IP)
GEO_FALLBACK_ENABLED=false
GEO_FALLBACK_TIMEOUT_SECONDS=3
TWOIP_TOKEN=
TWOIP_BASE_URL=https://api.2ip.io

# GeoLite2 paths
GEOLITE_ASN_PATH=/app/data/GeoLite2-ASN.mmdb
GEOLITE_CITY_PATH=/app/data/GeoLite2-City.mmdb

# GeoLite2 auto-download
GEOLITE_ASN_DOWNLOAD_URL=https://raw.githubusercontent.com/P3TERX/GeoLite.mmdb/download/GeoLite2-ASN.mmdb
GEOLITE_CITY_DOWNLOAD_URL=https://raw.githubusercontent.com/P3TERX/GeoLite.mmdb/download/GeoLite2-City.mmdb
GEOLITE_UPDATE_INTERVAL_HOURS=168

# Config directory (providers.yaml, agglomerations.yaml)
GEODATA_CONFIG_DIR=/app/config

# Writable data directory (unknown_providers.json, backups)
GEODATA_DATA_DIR=/app/data

# ============================================
# SCORING
# ============================================
SCORING_ENABLED=true
SCORE_THRESHOLD_WARN=50.0
SCORE_THRESHOLD_BLOCK=85.0

# ============================================
# UNKNOWN PROVIDERS / AUTO-LEARNING
# ============================================
UNKNOWN_PROVIDERS_LOG_ENABLED=true

AUTO_LEARNING_ENABLED=true
AUTO_LEARNING_INTERVAL_HOURS=24
AUTO_LEARNING_MIN_COUNT=10
AUTO_LEARNING_MIN_CONFIDENCE=high
AUTO_LEARNING_MAX_ADDS_PER_RUN=20
AUTO_LEARNING_OUTPUT_FILE=providers.learned.yaml
AUTO_LEARN_MIN_DISTINCT_USERS=3
AUTO_LEARN_AUTO_APPROVE_THRESHOLD=0.8

# ============================================
# CAIDA AS-ORGANIZATIONS
# ============================================
CAIDA_ENABLED=true
CAIDA_DOWNLOAD_URL=
CAIDA_REFRESH_HOURS=168

# ============================================
# DEBUG
# ============================================
DEBUG_EMAIL=
DEBUG_IP_LIMIT=1
