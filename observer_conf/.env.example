# Переменные для сервиса observer

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# Redis SCAN настройки
SCAN_COUNT=100                # hint COUNT для SCAN команд
SCAN_TIME_BUDGET_SECONDS=30   # макс. время одной SCAN операции

# ============================================
# REMNAWAVE API (блокировка на уровне пользователей)
# ============================================

# URL панели Remnawave
REMNAWAVE_API_URL=https://your-panel.example.com

# API токен для доступа к панели
REMNAWAVE_API_TOKEN=your_api_token_here

# Время блокировки пользователя (формат: 5m, 10m, 1h)
BLOCK_DURATION=10m

# Интервал проверки автоматического разблокирования (секунды)
REENABLE_TICK_SECONDS=10

# ============================================
# РЕЖИМЫ ОБНАРУЖЕНИЯ (выберите ОДИН)
# ============================================

# 1. РЕЖИМ ASN (по провайдерам) - РЕКОМЕНДУЕТСЯ для анти-шаринга
# Определяет провайдера/оператора по IP и группирует все IP одного провайдера
# Идеально для обнаружения реального шаринга между разными людьми
DETECT_BY_ASN=true
MAX_ASNS_PER_USER=4

# Параметры ASN (iptoasn.com - автоматически скачивается при старте)
# URL для скачивания базы ASN (по умолчанию https://iptoasn.com/data/ip2asn-v4.tsv.gz)
# Можно оставить пустым - будет использовано значение по умолчанию
IPTOASN_DOWNLOAD_URL=
# Интервал обновления базы в минутах (по умолчанию 60)
IPTOASN_UPDATE_INTERVAL_MINUTES=60

ASN_FALLBACK_MASK=16
# Исключенные ASN (CDN, крупные сервисы)
EXCLUDED_ASNS=AS13335,AS15169,AS16509

# 2. РЕЖИМ ДЕТЕКЦИИ ПО ПОДСЕТЯМ (альтернатива)
# DETECT_BY_SUBNET=true
# DETECT_BY_ASN=false
# MAX_SUBNETS_PER_USER=6
# SUBNET_MASK_IPV4=24
# EXCLUDED_SUBNETS=192.168.2.0/24,10.2.2.0/24

# 3. РЕЖИМ ДЕТЕКЦИИ ПО IP (простой, не рекомендуется)
# DETECT_BY_ASN=false
# DETECT_BY_SUBNET=false
# MAX_IPS_PER_USER=12
# EXCLUDED_IPS=1.1.1.1,8.8.8.8

# ============================================
# REDIS TTL
# ============================================

# TTL для записей в Redis (секунды, 1 час = 3600 сек)
USER_SUBNET_TTL_SECONDS=3600
USER_IP_TTL_SECONDS=3600

# ============================================
# HTTP SERVER
# ============================================

# Таймауты HTTP сервера (защита от slowloris и DoS)
HTTP_READ_HEADER_TIMEOUT_SECONDS=5  # Таймаут чтения заголовков
HTTP_READ_TIMEOUT_SECONDS=15        # Таймаут полного чтения запроса
HTTP_WRITE_TIMEOUT_SECONDS=15       # Таймаут записи ответа
HTTP_IDLE_TIMEOUT_SECONDS=60        # Таймаут keep-alive соединений
HTTP_MAX_HEADER_BYTES=1048576       # Макс. размер заголовков (1MB)

# Максимальный размер body POST /log-entry в байт (default: 2097152 = 2MB)
MAX_REQUEST_BYTES=2097152

# Максимальное количество записей в одном запросе (default: 1000)
MAX_LOG_ENTRIES_PER_REQUEST=1000

# Строгая валидация JSON
# false (default): дополнительные поля игнорируются (backward compatible с Vector)
# true: DisallowUnknownFields, unknown field → 400 invalid_json
STRICT_JSON_DECODE=false

# ============================================
# WEBHOOK ДЛЯ АЛЕРТОВ
# ============================================

# Укажите реальный URL вебхука вашего ТГ-бота
ALERT_WEBHOOK_URL=https://<IP_ВАШЕГО_БОТА>:<ПОРТ>/webhook/alert

# Кулдаун между алертами для одного пользователя (секунды)
ALERT_COOLDOWN_SECONDS=300

# ============================================
# ИСКЛЮЧЕНИЯ
# ============================================

# Исключенные пользователи (ID через запятую)
EXCLUDED_USERS=

# ============================================
# DEBUG
# ============================================

# Дебаг режим (опционально)
#DEBUG_EMAIL=debug_user
#DEBUG_IP_LIMIT=1

