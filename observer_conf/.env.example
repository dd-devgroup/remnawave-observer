# ============================================
# POSTGRESQL (required)
# ============================================

# PostgreSQL credentials
POSTGRES_USER=observer
POSTGRES_PASSWORD=observer_password
POSTGRES_DB=observer

# PostgreSQL connection string (auto-generated from above or manually set)
POSTGRES_DSN=postgres://observer:observer_password@postgres:5432/observer?sslmode=disable

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# Redis SCAN settings
SCAN_COUNT=100                # COUNT hint for SCAN commands
SCAN_TIME_BUDGET_SECONDS=30   # Max time for one SCAN operation

# ============================================
# REMNAWAVE API
# ============================================

# Remnawave panel URL
REMNAWAVE_BASE_URL=https://your-panel.example.com

# API token for panel access
REMNAWAVE_API_TOKEN=your_api_token_here

# User block duration (format: 5m, 10m, 1h)
BLOCK_DURATION=10m

# Re-enable check interval (seconds)
REENABLE_TICK_SECONDS=10

# ============================================
# DATA UPDATER SERVICE (observer-updater)
# ============================================
# The observer-updater service handles background downloads for:
# - iptoasn.com ASN database
# - CAIDA AS-Organizations dataset
# - GeoLite2 MMDB files (ASN, City)
#
# Files are written to ./data/ volume, shared with the main observer service.
# The observer service reads from these files and hot-reloads when they change.
#
# Architecture: updater writes, observer reads (separation of concerns)

# ============================================
# ASN DETECTION
# ============================================

# Max unique ASNs per user before action (default: 4)
MAX_ASNS_PER_USER=4

# TTL for ASN entries per user in seconds (default: 86400 = 24h)
USER_ASN_TTL_SECONDS=86400

# iptoasn.com database (auto-downloaded by observer-updater service)
# Leave empty for default URL
IPTOASN_DOWNLOAD_URL=
IPTOASN_UPDATE_INTERVAL_MINUTES=60

# Excluded ASNs (CDN, major services)
EXCLUDED_ASNS=AS13335,AS15169,AS16509

# ============================================
# HTTP SERVER
# ============================================

# Max POST /log-entry body size in bytes (default: 2097152 = 2MB)
MAX_REQUEST_BYTES=2097152

# Max entries per request (default: 1000)
MAX_LOG_ENTRIES_PER_REQUEST=1000

# ============================================
# WEBHOOK ALERTS
# ============================================

# Webhook URL for your TG bot
ALERT_WEBHOOK_URL=https://<BOT_IP>:<PORT>/webhook/alert

# Alert cooldown per user (seconds)
ALERT_COOLDOWN_SECONDS=300

# ============================================
# EXCLUSIONS
# ============================================

# Excluded users (comma-separated IDs)
EXCLUDED_USERS=

# Excluded IPs (comma-separated)
#EXCLUDED_IPS=1.1.1.1,8.8.8.8

# ============================================
# GEOIP ANALYSIS
# ============================================

# Enable GeoIP analysis
GEOIP_ENABLED=true

# GeoIP cache TTL in hours (default: 24)
GEOIP_CACHE_TTL_HOURS=24

# GeoLite2 MMDB files (optional — if missing, enrichment will be limited)
GEOLITE_ASN_PATH=/app/data/GeoLite2-ASN.mmdb
GEOLITE_CITY_PATH=/app/data/GeoLite2-City.mmdb

# GeoLite2 MMDB auto-download (handled by observer-updater service)
# Downloads from P3TERX/GeoLite.mmdb GitHub mirror
# If empty, files must be manually provided at the paths above
GEOLITE_ASN_DOWNLOAD_URL=https://raw.githubusercontent.com/P3TERX/GeoLite.mmdb/download/GeoLite2-ASN.mmdb
GEOLITE_CITY_DOWNLOAD_URL=https://raw.githubusercontent.com/P3TERX/GeoLite.mmdb/download/GeoLite2-City.mmdb
GEOLITE_UPDATE_INTERVAL_HOURS=168  # Default: 7 days

# Attribution: This product includes GeoLite2 Data created by MaxMind,
# available from https://www.maxmind.com (CC BY-SA 4.0 License)

# Config directory (agglomerations.yaml, providers.yaml)
# In Docker usually /app/config (read-only)
GEODATA_CONFIG_DIR=/app/config

# Writable data directory (unknown_providers.json, backups)
# In Docker usually /app/data (read-write)
GEODATA_DATA_DIR=/app/data

# ============================================
# SCORING
# ============================================

# Enable scoring system
SCORING_ENABLED=true

# Warning threshold (default: 50.0)
SCORE_THRESHOLD_WARN=50.0

# Hard disable threshold (default: 85.0)
SCORE_THRESHOLD_BLOCK=85.0

# Enable unknown providers logging (default: false)
UNKNOWN_PROVIDERS_LOG_ENABLED=true

# ============================================
# AUTO-LEARNING
# ============================================

# Enable auto-learning (default: false)
AUTO_LEARNING_ENABLED=true

# Check interval in hours (default: 24)
AUTO_LEARNING_INTERVAL_HOURS=24

# Min occurrences for auto-add (default: 10)
AUTO_LEARNING_MIN_COUNT=10

# Min confidence level: high, medium, low (default: high)
AUTO_LEARNING_MIN_CONFIDENCE=high

# Max new keywords per cycle (default: 20)
AUTO_LEARNING_MAX_ADDS_PER_RUN=20

# Overlay file name in dataDir (default: providers.learned.yaml)
AUTO_LEARNING_OUTPUT_FILE=providers.learned.yaml

# Min distinct users per ASN for Postgres-backed learning (default: 3)
AUTO_LEARN_MIN_DISTINCT_USERS=3

# Auto-approve confidence threshold (default: 0.8)
AUTO_LEARN_AUTO_APPROVE_THRESHOLD=0.8

# ============================================
# CAIDA AS-Organizations
# ============================================
# Downloaded by observer-updater service, read by main observer service

# Enable CAIDA AS-Organizations loading (default: true)
CAIDA_ENABLED=true

# CAIDA file URL (leave empty for default from CAIDA website)
CAIDA_DOWNLOAD_URL=

# CAIDA refresh interval in hours (default: 168 = 7 days)
CAIDA_REFRESH_HOURS=168

# ============================================
# DEBUG
# ============================================

# Debug mode (optional)
#DEBUG_EMAIL=debug_user
#DEBUG_IP_LIMIT=1
