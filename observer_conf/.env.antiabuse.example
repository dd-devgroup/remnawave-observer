# ========================================
# Anti-Abuse System - GeoIP и Scoring
# ========================================

# Включить GeoIP анализ
GEOIP_ENABLED=true

# TTL кеша GeoIP в часах (default: 24)
GEOIP_CACHE_TTL_HOURS=24

# Директория с конфигами (agglomerations.yaml, providers.yaml)
# В Docker обычно /app/config (read-only)
GEODATA_CONFIG_DIR=/app/config

# Директория для записываемых данных (unknown_providers.json, backups)
# В Docker обычно /app/data (read-write)
GEODATA_DATA_DIR=/app/data

# Включить систему скоринга
SCORING_ENABLED=true

# Порог предупреждения (default: 50.0)
# При скоре >= 50 отправляется предупреждение
SCORE_THRESHOLD_WARN=50.0

# Порог блокировки (default: 85.0)
# При скоре >= 85 происходит полная блокировка
SCORE_THRESHOLD_BLOCK=85.0

# Включить логирование неизвестных провайдеров (default: false)
# Система будет собирать статистику по провайдерам, которые не нашлись в providers.yaml
# Результат сохраняется в /app/config/unknown_providers.json
UNKNOWN_PROVIDERS_LOG_ENABLED=true

# ========================================
# Автоматическое обучение (Auto-Learning)
# ========================================

# Включить автоматическое обучение (default: false)
# Система будет автоматически анализировать unknown_providers.json
# и добавлять новых провайдеров в providers.yaml
AUTO_LEARNING_ENABLED=true

# Интервал проверки в часах (default: 24)
# Как часто запускать анализ и обновление
AUTO_LEARNING_INTERVAL_HOURS=24

# Минимальное количество встреч для автодобавления (default: 10)
# Провайдер должен встретиться минимум N раз, чтобы быть добавленным автоматически
AUTO_LEARNING_MIN_COUNT=10

# Минимальный уровень уверенности (default: high)
# Варианты: high (только высокая уверенность), medium (средняя и выше), low (низкая и выше)
# Рекомендуется: high для продакшена, medium для тестирования
AUTO_LEARNING_MIN_CONFIDENCE=high

# ========================================
# Примечания по скорингу:
# ========================================
# Скор рассчитывается по формуле:
# - ASN Score (40%): тип провайдера
#   * mobile = 0.3 (низкий риск)
#   * isp = 1.0 (средний риск)
#   * vpn/hosting = 1.5-1.8 (высокий риск)
#
# - Geo Score (35%): география
#   * одна агломерация = 0
#   * разные города = +5
#   * 2 страны = +15
#   * 3+ страны = +30
#
# - Count Score (25%): близость к лимиту
#
# Действия по скору:
# < 30  = none (без действий)
# 30-50 = monitor (мониторинг)
# 50-70 = warn (предупреждение)
# 70-85 = soft_block (мягкая блокировка)
# > 85  = block (полная блокировка)
